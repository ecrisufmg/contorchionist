#N canvas 0 0 1000 700 12;

# === SIMULADOR DE CANTO DE PÁSSARO + RUÍDO ===

# Ruído de fundo (ambiente)
#X obj 50 50 noise~;
#X obj 50 80 *~ 0.15;
#X obj 50 110 lop~ 3000;
#X text 150 80 ruído de fundo (ambiente);

# Transientes (simulando chirps de pássaros)
#X obj 50 200 metro 800;
#X obj 50 230 random 1500;
#X obj 50 260 + 2000;
#X obj 50 290 pack f 50;
#X msg 50 320 \$1 \$2;
#X obj 50 350 vline~;
#X obj 50 380 osc~;
#X obj 50 410 *~ 0.4;
#X obj 50 440 hip~ 1500;
#X text 150 200 chirps aleatórios 2-3.5kHz;

# Mixer
#X obj 50 490 +~;
#X text 150 490 sinal = ruído + chirps;

# RFFT
#X obj 50 530 torch.rfft~ -n 2048 -overlap 8;
#X obj 50 570 unpack~ 0 0;

# Canais ambisônicos fictícios (apenas W para teste)
#X obj 200 570 sig~ 0;

# === TESTE 1: MODO SLOPE (padrão) ===
#X obj 50 630 torch.amb.spectrails~ -order 1 -mode 0 -threshdb -50 -pregaindb 10;
#X text 350 630 SLOPE: detecção original;

# === TESTE 2: MODO PROMINENCE ===
#X obj 50 700 torch.amb.spectrails~ -order 1 -mode 1 -prominence 0.6 -threshdb -50 -pregaindb 10;
#X text 350 700 PROMINENCE: detecção por saliência;

# IRFFT para reconstruir
#X obj 50 760 pack~ 0 0;
#X obj 50 800 torch.irfft~ -n 2048 -overlap 8;
#X obj 50 840 *~ 0.3;
#X obj 50 880 dac~;

#X obj 400 760 pack~ 0 0;
#X obj 400 800 torch.irfft~ -n 2048 -overlap 8;
#X obj 400 840 *~ 0.3;
#X obj 400 880 dac~ 3 4;
#X text 500 880 saída modo prominence (canais 3-4);

# === CONTROLES ===
#X obj 650 50 tgl 25 0 empty empty chirps_ON 0 -8 0 12 -262144 -1 -1 1 1;
#X msg 650 90 stop;
#X msg 680 90 800;
#X text 650 20 Liga/desliga chirps;

#X obj 650 150 hsl 200 25 0.3 2 0 0 empty empty prominence 0 -9 0 12 -262144 -1 -1 8500 1;
#X obj 650 180 / 100;
#X msg 650 210 prominence \$1;
#X text 650 125 Ajuste prominence (0.3-2.0);

#X obj 650 250 hsl 200 25 -80 -20 0 0 empty empty threshold_dB 0 -9 0 12 -262144 -1 -1 15000 1;
#X msg 650 280 threshdb \$1;
#X text 650 225 Threshold em dB;

#X obj 650 320 hsl 200 25 0 30 0 0 empty empty pregain_dB 0 -9 0 12 -262144 -1 -1 5000 1;
#X msg 650 350 pregaindb \$1;
#X text 650 295 Pregain em dB;

#X obj 650 400 nbx 5 18 0.7 0.9999 0 0 empty empty decay 0 -8 0 12 -262144 -1 -1 0.999 256;
#X msg 650 430 decay \$1;
#X text 650 375 Decay factor (0.7-0.9999);

#X obj 650 480 nbx 5 18 0.1 0.99 0 0 empty empty attack 0 -8 0 12 -262144 -1 -1 0.7 256;
#X msg 650 510 attack \$1;
#X text 650 455 Attack (0.1-0.99);

#X text 50 10 TESTE: Detecção de Transientes (Bird Calls);
#X text 50 950 COMPARE: modo slope vs prominence;
#X text 50 970 Prominence deve capturar melhor os chirps transitórios;

