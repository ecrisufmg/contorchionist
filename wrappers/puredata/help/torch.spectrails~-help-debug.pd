#X text 837 255 torch.spectrails~ - Spectral Trails Effect;
#X text 837 285 Creates spectral memory/trails with threshold-based reinforcement;
#X text 837 305 Use inside [pfft~] between [torch.rfft~] and [torch.irfft~];
#X text 837 335 CREATION ARGUMENTS:;
#X text 857 355 @fftsize <N> - FFT size (default: 1024);
#X text 857 370 @threshold <f> - Magnitude threshold (default: 0.01);
#X text 857 385 @attack <f> - Attack coefficient 0-1 (default: 0.8);
#X text 857 400 @decay <f> - Decay factor 0-1 (default: 0.999);
#X text 857 415 @limiter <0|1> - Enable limiter (default: 0);
#X text 857 430 @maxvalue <f> - Max value for limiter (default: 1.0);
#X text 837 455 INLETS:;
#X text 857 475 1 Signal - Magnitude/Power/dB bins (N/2+1);
#X text 857 490 2 Signal - Phase bins (N/2+1);
#X text 837 515 OUTLETS:;
#X text 857 535 1 Signal - Processed magnitude/power/dB bins;
#X text 857 550 2 Signal - Processed phase bins;
#X text 837 575 MESSAGES:;
#X text 857 595 threshold <f> - Set threshold value;
#X text 857 610 attack <f> - Set attack coefficient (0-1);
#X text 857 625 decay <f> - Set decay factor (0-1);
#X text 857 640 limiter <0|1> - Enable/disable limiter;
#X text 857 655 maxvalue <f> - Set maximum value for limiter;
#X text 857 670 reset - Reset memory to zero;
#X text 837 695 PARAMETERS EXPLAINED:;
#X text 857 715 - threshold: Bins below this value won't be reinforced;
#X text 857 730 - attack: Higher = faster attack \, more of new signal;
#X text 857 745 - decay: Higher = slower decay \, longer trails (0.999 = 4s);
#X text 857 760 - limiter: Prevents output from exceeding maxvalue;
#X text 837 785 NOTE: DC and Nyquist bins are always zeroed for phase;
