#X text 1922 848 torch.spectrails~ - Spectral Trails Effect;
#X text 1922 878 Creates spectral memory/trails with threshold-based reinforcement;
#X text 1922 898 Use inside [pfft~] between [torch.rfft~] and [torch.irfft~];
#X text 1922 928 CREATION ARGUMENTS:;
#X text 1942 948 @fftsize <N> - FFT size (default: 1024);
#X text 1942 963 @threshold <f> - Magnitude threshold (default: 0.01);
#X text 1942 978 @attack <f> - Attack coefficient 0-1 (default: 0.8);
#X text 1942 993 @decay <f> - Decay factor 0-1 (default: 0.999);
#X text 1942 1008 @limiter <0|1> - Enable limiter (default: 0);
#X text 1942 1023 @maxvalue <f> - Max value for limiter (default: 1.0);
#X text 1922 1048 INLETS:;
#X text 1942 1068 1 Signal - Magnitude/Power/dB bins (N/2+1);
#X text 1942 1083 2 Signal - Phase bins (N/2+1);
#X text 1922 1108 OUTLETS:;
#X text 1942 1128 1 Signal - Processed magnitude/power/dB bins;
#X text 1942 1143 2 Signal - Processed phase bins;
#X text 1922 1168 MESSAGES:;
#X text 1942 1188 threshold <f> - Set threshold value;
#X text 1942 1203 attack <f> - Set attack coefficient (0-1);
#X text 1942 1218 decay <f> - Set decay factor (0-1);
#X text 1942 1233 limiter <0|1> - Enable/disable limiter;
#X text 1942 1248 maxvalue <f> - Set maximum value for limiter;
#X text 1942 1263 reset - Reset memory to zero;
#X text 1922 1288 PARAMETERS EXPLAINED:;
#X text 1942 1308 - threshold: Bins below this value won't be reinforced;
#X text 1942 1323 - attack: Higher = faster attack \, more of new signal;
#X text 1942 1338 - decay: Higher = slower decay \, longer trails (0.999 = 4s);
#X text 1942 1353 - limiter: Prevents output from exceeding maxvalue;
#X text 1922 1378 NOTE: DC and Nyquist bins are always zeroed for phase;
#X text 1738 1009 <- see inside;
