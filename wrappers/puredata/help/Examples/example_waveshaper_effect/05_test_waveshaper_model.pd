#N canvas 864 56 800 600 12;
#X declare -path ../../;
#X obj 68 499 dac~;
#X text 202 499 Output to DAC;
#X text 285 83 Load model with forward method;
#X obj 70 100 *~ 0.5;
#X obj 122 167 hsl 128 15 0 1 0 0 empty drive_slider Drive 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 141 221 hsl 128 15 0 1 0 0 empty tone_slider Tone 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 160 271 hsl 128 15 0 1 0 0 empty mix_slider Mix 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X text 257 162 Drive: 0=clean \, 1=heavy;
#X text 277 225 Tone: 0=dark \, 0.5=flat \, 1=bright;
#X text 299 272 Mix: 0=dry \, 1=wet;
#X text 70 30 === Waveshaper Effect - Neural Audio Processing ===;
#X text 68 549 Model expects: [64 audio samples \, drive \, tone \, mix];
#X obj 68 449 *~ 0.8;
#X text 123 450 Output gain;
#X text 143 408 Convert back to audio stream;
#X obj 505 28 declare -path ../../;
#X obj 70 50 osc~ 440;
#X obj 150 64 noise~;
#X obj 150 88 *~ 0.2;
#X obj 70 137 +~;
#X msg 119 188 set drive \$1;
#X msg 138 243 set tone \$1;
#X msg 157 296 set mix \$1;
