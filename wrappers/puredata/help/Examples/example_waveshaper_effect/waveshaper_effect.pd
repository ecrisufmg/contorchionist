#N canvas 422 217 800 600 12;
#X declare -path ../../;
#X obj 50 500 dac~;
#X text 200 500 Output to DAC;
#X text 454 198 Load model with forward method;
#X obj 50 100 *~ 0.5;
#X obj 350 150 hsl 128 15 0 1 0 0 empty drive_slider Drive 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 350 170 / 127;
#X obj 350 250 hsl 128 15 0 1 0 0 empty tone_slider Tone 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 350 270 / 127;
#X obj 350 350 hsl 128 15 0 1 0 0 empty mix_slider Mix 5 8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 350 370 / 127;
#X text 490 150 Drive: 0=clean \, 1=heavy;
#X text 490 250 Tone: 0=dark \, 0.5=flat \, 1=bright;
#X text 490 350 Mix: 0=dry \, 1=wet;
#X obj 350 200 s drive_param;
#X obj 350 300 s tone_param;
#X obj 350 400 s mix_param;
#X obj 357 78 r drive_param;
#X obj 387 98 r tone_param;
#X obj 417 118 r mix_param;
#X text 50 30 === Waveshaper Effect - Neural Audio Processing ===;
#X text 50 550 Model expects: [64 audio samples \, drive \, tone \, mix];
#X obj 50 450 *~ 0.8;
#X text 120 450 Output gain;
#X text 136 226 Convert back to audio stream;
#X obj 505 28 declare -path ../../;
#X obj 50 50 osc~ 440;
#X obj 130 64 noise~;
#X obj 130 88 *~ 0.2;
#X obj 70 137 +~;
#X obj 50 200 torch.ts~ waveshaper.ts -m forward;
#X obj 122 142 sig~ 0.7;
#X obj 193 141 sig~ 0.5;
#X obj 266 136 sig~ 0.9;
