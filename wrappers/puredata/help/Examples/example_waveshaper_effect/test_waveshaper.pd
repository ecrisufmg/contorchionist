#N canvas 604 100 800 600 12;
#X declare -path ../../;
#X obj 20 20 declare -path ../../;
#N canvas 0 0 450 300 (subpatch) 0;
#X array input_signal 64 float 2;
#A color 0;
#A width 2;
#X coords 0 1 64 -1 200 140 1;
#X restore 50 400;
#N canvas 0 0 450 300 (subpatch) 0;
#X array output_signal 64 float 2;
#A color 0;
#A width 2;
#X coords 0 1 64 -1 200 140 1;
#X restore 300 400;
#X text 50 30 Waveshaper Effect Test;
#X text 50 50 ========================;
#X text 50 80 1 Generate test signal (440Hz);
#X obj 50 100 osc~ 440;
#X obj 49 131 *~ 0.5;
#X text 50 150 2 Process with waveshaper model;
#X text 50 165 - Inlet 0: audio signal;
#X text 50 180 - Inlet 1: drive (0-1);
#X text 50 195 - Inlet 2: tone (0-1);
#X text 50 210 - Inlet 3: mix (0-1);
#X obj 50 240 torch.ts~ waveshaper.ts -m forward -v;
#X text 150 290 <- drive;
#X obj 150 310 hsl 128 15 0 1 0 0 empty empty drive 5 7 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 150 330 5 0 1 0 - - - 0;
#X text 300 290 <- tone;
#X obj 300 310 hsl 128 15 0 1 0 0 empty empty tone 5 7 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 300 330 5 0 1 0 - - - 0;
#X text 450 290 <- mix;
#X obj 450 310 hsl 128 15 0 1 0 0 empty empty mix 5 7 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 450 330 5 0 1 0 - - - 0;
#X text 50 360 3 Listen;
#X obj 50 380 dac~;
#X text 550 80 INSTRUCTIONS:;
#X text 550 100 1 Move the sliders to adjust:;
#X text 570 120 drive: distortion amount;
#X text 570 135 tone: brightness;
#X text 570 150 mix: dry/wet blend;
#X text 550 180 2 Click [dsp 1] to start audio;
#X text 550 200 3 Adjust parameters in real-time;
#X obj 550 230 loadbang;
#X msg 550 250 \; pd dsp 1;
#X obj 150 353 sig~;
#X obj 299 354 sig~;
#X obj 449 356 sig~;
#X connect 6 0 7 0;
#X connect 7 0 13 0;
#X connect 13 0 24 0;
#X connect 15 0 16 0;
#X connect 16 0 34 0;
#X connect 18 0 19 0;
#X connect 19 0 35 0;
#X connect 21 0 22 0;
#X connect 22 0 36 0;
#X connect 34 0 13 1;
#X connect 35 0 13 2;
#X connect 36 0 13 3;
