#N canvas 100 100 800 600 12;
#X declare -path ../../;
#X obj 20 20 declare -path ../../;

#X text 50 50 Waveshaper Debug Test;
#X text 50 70 ====================;

#X text 50 100 INPUT: 440Hz sine \, amplitude 0.5;
#X obj 50 120 osc~ 440;
#X obj 50 140 *~ 0.5;

#X text 50 170 INPUT MONITOR (before processing);
#X obj 50 190 snapshot~;
#X obj 50 210 nbx 8 14 -1 1 0 0 empty empty input -60 7 0 10 #fcfcfc #000000 #000000 0 256;
#X obj 50 230 metro 100;
#X obj 50 250 tgl 15 0 empty empty monitor 17 7 0 10 #fcfcfc #000000 #000000 1 1;

#X text 250 100 PARAMETERS (as DC audio signals);
#X obj 250 120 nbx 5 14 0 1 0 0 empty empty drive 0 -8 0 10 #fcfcfc #000000 #000000 0.7 256;
#X obj 250 140 sig~;
#X obj 350 120 nbx 5 14 0 1 0 0 empty empty tone 0 -8 0 10 #fcfcfc #000000 #000000 0.6 256;
#X obj 350 140 sig~;
#X obj 450 120 nbx 5 14 0 1 0 0 empty empty mix 0 -8 0 10 #fcfcfc #000000 #000000 0.9 256;
#X obj 450 140 sig~;

#X text 50 290 PROCESSING;
#X obj 50 310 torch.ts~ waveshaper.ts -v;

#X text 50 350 OUTPUT MONITOR;
#X obj 50 370 snapshot~;
#X obj 50 390 nbx 8 14 -2 2 0 0 empty empty output -60 7 0 10 #fcfcfc #000000 #000000 0 256;

#X text 50 430 OUTPUT (with gain control);
#X obj 50 450 *~ 0.5;
#X obj 150 430 nbx 5 14 0 2 0 0 empty empty gain 0 -8 0 10 #fcfcfc #000000 #000000 0.5 256;
#X obj 50 480 dac~;

#X text 50 520 DSP CONTROL;
#X msg 50 540 \; pd dsp 1;
#X msg 120 540 \; pd dsp 0;

#X text 550 100 INSTRUCTIONS:;
#X text 550 130 1. Click "monitor" toggle;
#X text 550 150 2. Check "input" value (~0.5);
#X text 550 170 3. Turn DSP on;
#X text 550 190 4. Check "output" value;
#X text 550 210 5. Adjust parameters;
#X text 550 230 6. Adjust output gain;
#X text 550 250 7. Listen!;

#X text 550 280 Expected:;
#X text 550 300 - Input: ~0.5 amplitude;
#X text 550 320 - Output: ~0.8-1.0 (distorted);
#X text 550 340 - Sound: distorted sine;

#X connect 4 0 5 0;
#X connect 5 0 7 0;
#X connect 5 0 19 0;
#X connect 7 0 8 0;
#X connect 9 0 7 0;
#X connect 10 0 9 0;
#X connect 12 0 13 0;
#X connect 13 0 19 1;
#X connect 14 0 15 0;
#X connect 15 0 19 2;
#X connect 16 0 17 0;
#X connect 17 0 19 3;
#X connect 19 0 21 0;
#X connect 19 0 24 0;
#X connect 21 0 22 0;
#X connect 9 0 21 0;
#X connect 24 0 26 0;
#X connect 24 0 26 1;
#X connect 25 0 24 1;
