#N canvas 0 0 800 600 12;

# Gerador de áudio de teste
#X obj 50 50 osc~ 440;
#X obj 50 80 *~ 0.3;

# RFFT para gerar magnitude e phase
#X obj 50 120 torch.rfft~ -n 1024 -overlap 4;

# Canais ambisônicos (W, X, Y, Z para ordem 1)
# W = omnidirecional (usamos o sinal original)
# X, Y, Z = zeros (para teste simples)

# Canal W (magnitude e phase)
#X obj 50 160 unpack~ 0 0;

# Canais X, Y, Z com magnitude/phase zero
#X obj 200 160 sig~ 0;
#X obj 250 160 sig~ 0;

# torch.amb.spectrails~ com modo prominence
# Sintaxe: [torch.amb.spectrails~ -order 1 -mode 1 -prominence 0.6 -thresh 0.01]
#X obj 50 220 torch.amb.spectrails~ -order 1 -mode 1 -prominence 0.6 -threshdb -60 -pregaindb 20;

# Saídas: out_mag_W, out_phase_W, out_mag_X, out_phase_X, etc
# Vamos pegar apenas W
#X obj 50 280 pack~ 0 0;

# IRFFT para reconstruir áudio
#X obj 50 320 torch.irfft~ -n 1024 -overlap 4;

# Monitor de saída
#X obj 50 360 dac~;

# Controles para testar em tempo real
#X obj 400 50 vsl 15 128 0 1 0 0 empty empty prominence 0 -9 0 10 -262144 -1 -1 7600 1;
#X obj 400 190 / 100;
#X msg 400 220 prominence \$1;

#X obj 450 50 vsl 15 128 -120 0 0 0 empty empty thresh_dB 0 -9 0 10 -262144 -1 -1 6000 1;
#X msg 450 190 threshdb \$1;

#X obj 500 50 vsl 15 128 -40 40 0 0 empty empty pregain_dB 0 -9 0 10 -262144 -1 -1 6000 1;
#X msg 500 190 pregaindb \$1;

#X obj 550 50 tgl 15 0 empty empty mode 17 7 0 10 -262144 -1 -1 1 1;
#X msg 550 80 mode \$1;

#X text 400 10 CONTROLES:;
#X text 400 25 prominence: 0-1 (0.6=sigmund~);
#X text 450 25 threshold: -120 a 0 dB;
#X text 500 25 pregain: -40 a +40 dB;
#X text 550 25 mode: 0=slope \, 1=prominence;

#X text 50 20 TESTE: torch.amb.spectrails~ modo PROMINENCE;
#X text 50 400 Para testar com ruído + transientes (pássaros)\, use [noise~] + [bp~];

# Conexões
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X connect 3 0 6 0;
#X connect 3 1 6 1;
#X connect 4 0 6 2;
#X connect 4 0 6 3;
#X connect 5 0 6 4;
#X connect 5 0 6 5;
#X connect 4 0 6 6;
#X connect 4 0 6 7;
#X connect 6 0 7 0;
#X connect 6 1 7 1;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 0 9 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 6 0;
#X connect 13 0 14 0;
#X connect 14 0 6 0;
#X connect 15 0 16 0;
#X connect 16 0 6 0;
#X connect 17 0 18 0;
#X connect 18 0 6 0;
